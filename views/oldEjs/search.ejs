<%- include("partials/header.ejs") %>

<div class="container">

    <div class="row">
      <% if (wasUserFound) { %>
        <% for (var i = 0; i < userData.length; i++) {%>
            
                <div class="d-flex flex-column align-items-center justify-content-center mt-2 col-2">
                    <a href="/player/<%= userData[i].id%>" style="text-decoration: none;">
                        <% if (!userData[i].picture) {%>
                            <div class="pfp" style="background-image: url('http://localhost:3001/assets/default-pfp.jpg')"></div> 
                        <% } else { %>
                            <div class="pfp" style="background-image: url('<%= userData[i].picture%>')"></div>
                        <% } %>
                        <h2 style="color: #EAD8B1"><%= userData[i].display_name%></h2>
                    </a>
                </div>          
        <% } %>
        <div class="d-flex justify-content-center py-5">
          <form action="/search" method="GET">
              <h2>Not who you were looking for? Search Again for a User</h2>
              <div class="form-group">
                  <input type="text" class="form-control" id="exampleFormControlInput1" name="user" placeholder="speedx77" required>
              </div>
              <div class="d-flex justify-content-center">
                  <input class="mt-2" type="submit" value="Search">
              </div>
          </form>
      </div>   
      <% } 
      else { %>
        
        <div class="d-flex justify-content-center py-5">
          <form action="/search" method="GET">
              <h2>User was not found on Spotify, sorry!</h2>
              <h2>Search Again for a User</h2>
              <div class="form-group">
                  <input type="text" class="form-control" id="exampleFormControlInput1" name="user" placeholder="speedx77" required>
              </div>
              <div class="d-flex justify-content-center">
                  <input class="mt-2" type="submit" value="Search">
              </div>
          </form>
      </div>
    <% } %>
    </div>
</div>



