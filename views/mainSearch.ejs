<script src="/scripts/playerJS.js"></script>
<script>

    
var token2 = ""
var currentUser = {};
var profileShowing = false;
var searchBegan = false;
var infoShowing = false;


if (document.cookie.indexOf("at") === (-1)){

        window.location.replace("http://localhost:3001/")
        console.log("Error: User Must Login")

} else {
    token2 = document.cookie.split("at=")[1].split(";")[0];
}



async function getCurrentUser() {

    const response = await fetch("https://api.spotify.com/v1/me", {
        method: "GET",
        headers: {
            "Authorization" : `Bearer ${token2}`
        }
    }).then(response => response.json()).then(data => {
        currentUser = {
            profileImage: data.images[0].url,
            profileId : data.id,
            displayName : data.display_name,
            profileLink: "https://open.spotify.com/user/" + data.id
        }
    });

    $("#currentUserPfp").css({"background-image" : `url('${currentUser.profileImage}')`});
    $("#currentUserDisplayName").html(currentUser.displayName);
}

getCurrentUser();

$("#userSearch").click(() => {
    searchBegan = true;
})

$("#profile").click(() => {

    if(searchBegan === false) {
        if (profileShowing != true) {
        $("#searchBlock").css({"display" : "none"});
        $("#loadingBlockSearch").css({"display" : "none"});
        $("#infoBlock").css({"display" : "none"});
        $("#profileBlock").css({"display" : "block"});
        profileShowing = true;
        infoShowing = false;
    } else{
        $("#profileBlock").css({"display" : "none"});
        $("#infoBlock").css({"display" : "none"});
        $("#loadingBlockSearch").css({"display" : "none"});
        $("#searchBlock").css({"display" : "flex"});
        profileShowing = false;
        infoShowing = false;
    }
    } else if(searchBegan === true) {
        if (profileShowing != true) {
            $("#searchBlock").css({"display" : "none"});
            $("#loadingBlockSearch").css({"display" : "none"});
            $("#infoBlock").css({"display" : "none"});
            $("#profileBlock").css({"display" : "block"});
            profileShowing = true;
            infoShowing = false;
        } else{
            $("#profileBlock").css({"display" : "none"});
            $("#infoBlock").css({"display" : "none"});
            $("#searchBlock").css({"display" : "none"});
            $("#loadingBlockSearch").css({"display" : "flex"});
            profileShowing = false;
            infoShowing = false;
        }
    }
})

$("#info").click(() => {

    if(searchBegan === false) {
        if (infoShowing != true) {
        $("#searchBlock").css({"display" : "none"});
        $("#loadingBlockSearch").css({"display" : "none"});
        $("#profileBlock").css({"display" : "none"});
        $("#infoBlock").css({"display" : "block"});
        infoShowing = true;
        profileShowing = false;
    } else{
        $("#infoBlock").css({"display" : "none"});
        $("#profileBlock").css({"display" : "none"});
        $("#loadingBlockSearch").css({"display" : "none"});
        $("#searchBlock").css({"display" : "flex"});
        infoShowing = false;
        profileShowing = false;
    }
    } else if(searchBegan === true) {
        if (infoShowing != true) {
            $("#searchBlock").css({"display" : "none"});
            $("#loadingBlockSearch").css({"display" : "none"});
            $("#profileBlock").css({"display" : "none"});
            $("#infoBlock").css({"display" : "block"});
            infoShowing = true;
            profileShowing = false;
        } else{
            $("#infoBlock").css({"display" : "none"});
            $("#profileBlock").css({"display" : "none"});
            $("#searchBlock").css({"display" : "none"});
            $("#loadingBlockSearch").css({"display" : "flex"});
            infoShowing = false;
            profileShowing = false;
        }
    }
})

$(".back").click(() => {

    if(searchBegan === false) {  
        $("#profileBlock").css({"display" : "none"});
        $("#infoBlock").css({"display" : "none"});
        $("#loadingBlockSearch").css({"display" : "none"});
        $("#searchBlock").css({"display" : "flex"});
        profileShowing = false;
        infoShowing = false; 
    } else if(searchBegan === true) {  
        $("#profileBlock").css({"display" : "none"});
        $("#infoBlock").css({"display" : "none"});
        $("#searchBlock").css({"display" : "none"});
        $("#loadingBlockSearch").css({"display" : "flex"});
        profileShowing = false;
        infoShowing = false;
    }
})


$("#logout").click(() => {
    document.cookie = `at=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
    document.cookie = `rt=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
    window.location.replace("/")
})

$("#spotifyLink").click(() => {
    window.open(currentUser.profileLink, "_blank");
})



    
    
</script>