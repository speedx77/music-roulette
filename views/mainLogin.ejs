<script src="/scripts/playerJS.js"></script>
<script>

var infoShowing = false;

if (document.cookie.indexOf("at") != (-1)){
        window.location.replace("http://localhost:3001/me")
        console.log("User Already Logged In")
}

$("#info").click(() => {

    if (infoShowing != true) {
        $("#loginBlock").css({"display" : "none"});
        $("#infoBlock").css({"display" : "block"});
        infoShowing = true;
    } else{
        $("#infoBlock").css({"display" : "none"});
        $("#loginBlock").css({"display" : "flex"});
        infoShowing = false;
    }
 
})


$(".back").click(() => {
    if (infoShowing != true) {
        $("#loginBlock").css({"display" : "none"});
        $("#infoBlock").css({"display" : "block"});
        infoShowing = true;
    } else{
        $("#infoBlock").css({"display" : "none"});
        $("#loginBlock").css({"display" : "flex"});
        infoShowing = false;
    }
})






</script>




    

