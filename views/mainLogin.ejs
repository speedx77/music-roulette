<%- include("partials/rouletteHeader.ejs") %>


<div class="container">

    <div class="d-flex flex-wrap align-items-center justify-content-center">

        <div id="player">

            
            <div class="row mt-3">
                <div class="col d-flex justify-content-center mt-4">
                    <!-- Screen Container -->
                    
                    <div id="screen">

                        <div class="d-flex mx-3 align-items-center justify-content-between">
                            <div id="time">12:05</div>
                            <div id="battery"></div>
                        </div>
                        <div id="divider"></div>
                        <!-- song player -->
                        <%- include("partials/loginArea.ejs") %>
                        
                    </div>
                    
                </div>
            </div>

            <!---TO: DO -> Add border/ shadow inset/ or shadow on random and mute buttons to give 3d effect, reference button wheel-->
            <div class="d-flex align-items-center justify-content-center gap-5">
                    <div id="circle">
                        <div id="q1" class="quarter"> <div id="raise-volume"></div> </div>
                        <div id="q2" class="quarter"> <div id="skip"></div> </div>
                        <div id="q3" class="quarter"> <div id="previous"></div> </div>
                        <div id="q4" class="quarter"> <div id="lower-volume"></div> </div>
                        <div class="center-button"> <div id="play"></div> </div>
                    </div>                

                    

                <div class="d-flex flex-column align-items-center justify-content-center">
                    <div id="randomize"> <div id="randomIcon"></div> </div>
                    <div id="mute"><div id="muteIcon"></div></div>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-center" style="margin-top: 150px;">
                <p id="footerNote">roulette | ryan burnett</p>
            </div>

            
