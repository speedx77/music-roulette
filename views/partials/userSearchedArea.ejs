<div class="row">
    <div class="col px-0">
        <div class="searchContainerAfter d-flex flex-wrap justify-content-center" style="overflow-y: scroll;">
            <% if (wasUserFound) { %>
                <% for (var i = 0; i < userData.length; i++) {%>
                    
                        <div class="d-flex flex-wrap justify-content-center mt-1 col-4">
                            <a href="/player/<%= userData[i].id%>" style="text-decoration: none;">
                                <% if (!userData[i].picture) {%>
                                    <div class="pfp" style="background-image: url('http://localhost:3001/assets/default-pfp.jpg')"></div> 
                                <% } else { %>
                                    <div class="pfp" style="background-image: url('<%= userData[i].picture%>')"></div>
                                <% } %>
                                <h2 class="d-flex justify-content-center" style="font-size: 20px; color: black; text-overflow: ellipsis;"><%= userData[i].display_name%></h2>
                            </a>
                        </div>          
                <% } %>
                <div class="searchContainerAfter d-flex justify-content-center align-items-center ms-1" style="height: 125px">
                    <form action="/search" method="GET">
                        <div class="d-flex justify-content-center"><h2>Search Again for a User</h2></div>
                        <div class="form-group">
                            <input type="text" class="form-control" id="exampleFormControlInput1" name="user" placeholder="ex. speedx77" required>
                        </div>
                        <div class="d-flex justify-content-center">
                            <input class="mt-2" type="submit" value="Search">
                        </div>
                    </form>
                </div>
            <% } 
            else { %>
                
                <div class="d-flex justify-content-center py-5">
                <form action="/search" method="GET">
                    <h2>User was not found on Spotify, sorry!</h2>
                    <h2>Search Again for a User</h2>
                    <div class="form-group">
                        <input type="text" class="form-control" id="exampleFormControlInput1" name="user" placeholder="speedx77" required>
                    </div>
                    <div class="d-flex justify-content-center">
                        <input class="mt-2" type="submit" value="Search">
                    </div>
                </form>
            </div>
            <% } %>
        </div>
    </div>
</div>