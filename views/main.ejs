<%- include("partials/rouletteHeader.ejs") %>


<div class="container">

    <div class="d-flex flex-wrap align-items-center justify-content-center">

        <div id="player">

            <div class="row mt-3">
                <div class="col d-flex justify-content-center mt-4">
                    <div id="screen">

                        <div class="d-flex mx-3 align-items-center justify-content-between">
                            <div id="time">12:05</div>
                            <div id="battery"></div>
                        </div>
                        <div id="divider"></div>
                        <div class="row" style="margin-left: 10px; margin-top: 10px" id="musicArea">
                            <div class="col" id="art" style="margin-top: 10px; background-image: url('http://localhost:3001/assets/stranger-in-the-alps.png');" ></div>
                            <div class="col py-4" style="margin-top: 10px" id="songInfo">
                                <div class="row mt-1">
                                    <div class="col justify-content-start trackNameContainer">
                                        <h2 id="trackName" class=""><b>Smoke Signals</b></h2>
                                    </div>
                                </div>
                                <div class="row mt-1">
                                    <div class="col justify-content-start artistNameContainer">
                                        <h2 id="artistName" class=""><b>Phoebe Bridgers</b></h2>
                                    </div>
                                </div>
                                <div class="row mt-1">
                                    <div class="col justify-content-start trackInfoContainer">
                                        <h3 id="trackInfo" class=""><b>Stranger in the Alps<span> - </span><span>Phoebe Bridgers</span></b></h3>
                                    </div>
                                </div>
                                <div class="row mt-1">
                                    <div class="col justify-content-start playlistInfoContainer">
                                        <h4 id="playlistInfo" class=""><b>Found on <span> <em>Phoebe Goddess Bridgers</em> </span> - <span><h3>speedx77</h3></span></b></h4>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-1 d-flex align-items-center justify-content-center ">
                                <div class="col-1 px-0 me-2" id="position">0:00</div>
                                <div class="progress px-0 col-11"><input type="range" min="0" max="100" value="0" id="progress-input"></div>
                                <!--progress bar: https://css-tricks.com/lets-create-a-custom-audio-player/-->
                                <!--custom range input custom css builder: https://range-input-css.netlify.app/-->
                                <!--<div id="progress-bar" style="width: 10%"></div>-->
                                <!--<div class="col-10 px-0" style="width: fit-content"><input  type="range" min="0" max="100" value="20" id="progress-input-bar" class="slider"></div>-->
                                <!--<input  type="range" min="0" max="100" value="0" id="progress-input-bar" class="slider">-->
                                <div class="col-1 px-0 ms-2" id="duration">4:42</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-center gap-5">
                    <div id="circle">
                        <div id="q1" class="quarter"> <div id="raise-volume"></div> </div>
                        <div id="q2" class="quarter"> <div id="skip"></div> </div>
                        <div id="q3" class="quarter"> <div id="previous"></div> </div>
                        <div id="q4" class="quarter"> <div id="lower-volume"></div> </div>
                        <div class="center-button"> <div id="play"></div> </div>
                    </div>                

                    

                <div class="d-flex flex-column align-items-center justify-content-center">
                    <div id="randomize"> <div id="randomIcon"></div> </div>
                    <div id="mute"><div id="muteIcon"></div></div>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-center" style="margin-top: 150px;">
                <p id="footerNote">roulette | ryan burnett</p>
            </div>

            
