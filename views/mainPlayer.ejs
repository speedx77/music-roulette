<%- include("partials/rouletteHeader.ejs") %>


<div class="container pt-3 pb-3">

    <div class="d-flex flex-wrap align-items-center justify-content-center">

        <div id="player">

            
            <div class="row mt-3">
                <div class="col d-flex justify-content-center mt-4">
                    <!-- Screen Container -->
                    
                    <div id="screen">

                        <div class="d-flex mx-3 align-items-center justify-content-between">
                            <div id="time">12:05</div>
                            <button id="profile"></button>
                            <a id="search" href="/me"></a>
                            <div id="battery"></div>
                        </div>
                        <div id="divider"></div>
                        <!-- song player -->
                        <div style="display: block;" id="loadingBlock"><%- include("partials/loadingArea.ejs") %></div>
                        <div style="display: none;" id="songBlock"><%- include("partials/songArea.ejs") %></div>
                        <div style="display: none;" id="profileBlock"><%- include("partials/profileArea.ejs") %></div>

                    </div>
                    
                </div>
            </div>

            <!---TO: DO -> Add border/ shadow inset/ or shadow on random and mute buttons to give 3d effect, reference button wheel-->
            <div class="d-flex align-items-center justify-content-center gap-5">
                    <div id="circle">
                        <button id="q1" class="quarter"> <div id="raise-volume"></div> </button>
                        <button id="q2" class="quarter"> <div id="skip"></div> </button>
                        <button id="q3" class="quarter"> <div id="previous"></div> </button>
                        <button id="q4" class="quarter"> <div id="lower-volume"></div> </button>
                        <button class="center-button"> <div id="play"></div> </button>
                    </div>                

                    

                <div class="d-flex flex-column align-items-center justify-content-center">
                    <button id="randomize" data-user="<%= locals.userId %>""> <div id="randomIcon"></div> </button>
                    <button id="mute"><div id="muteIcon"></div></button>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-center" style="margin-top: 50px;">
                <p id="footerNote">roulette | ryan burnett</p>
            </div>

            
                <!--
            <div class="outer-ring">
                <div class="cross"></div>

                <svg viewBox="-150 5 350 350">
                          <path id="curve" d="m0,30 c16,-4 32,-4 48,0" />
                          <text>
                              <textPath xlink:href="#curve">menu</textPath>
                          </text>
                      </svg>
                <div class="skip forward"></div>
                      <div class="skip back"></div>
                <div class="play-pause"></div>
                      <div class="touch-wheel">
                          <div class="center-button"></div>
                      </div>	
                      		
                </div>
                -->	
        </div>

    </div>

</div>
<script src="https://sdk.scdn.co/spotify-player.js"></script>
<script src="/scripts/playerJS.js"></script>
<script src="/scripts/playerActions.js"></script>
<script src="https://unpkg.com/color.js@1.2.0/dist/color.js"></script>
<script>

    if (document.cookie.indexOf("at") === (-1)){
            window.location.replace("http://localhost:3001/")
    }

    console.log("Error: User Must Login")
    
    
